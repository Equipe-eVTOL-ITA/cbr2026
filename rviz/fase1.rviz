    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Bases1
      Splitter Ratio: 0.5
    Tree Height: 346
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
